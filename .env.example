# Copy this file to .env and replace these examples with your Supabase project values.
# Never put a service-role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# For a legacy anon key, comment out the publishable-key line and use this instead:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
