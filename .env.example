# Copy this file to .env and replace these examples with your Supabase project values.
# Never put a service-role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternatively, set VITE_SUPABASE_ANON_KEY if the project uses the legacy anon key.
VITE_SUPABASE_ANON_KEY=
